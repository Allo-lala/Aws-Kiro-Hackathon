  "_documentation": {
    "file_format": {
      "description": "This JSON file defines environment-specific configurations for the Rutty application deployment workflow",
      "structure": {
        "environments": "Object containing configuration for each environment (production, staging, development)",
        "environment_object": {
          "name": "Environment identifier (string)",
          "description": "Human-readable description of the environment",
          "databaseUrl": "PostgreSQL connection string for the environment database",
          "apiBaseUrl": "Base URL for the backend API",
          "frontendUrl": "Base URL for the frontend application",
          "vercelProjectId": "Vercel project ID (optional, only for cloud deployments)",
          "vercelTeamId": "Vercel team ID (optional, for team accounts)",
          "environmentVariables": "Object containing all environment variables as key-value pairs"
        }
      }
    },
    "required_variables": {
      "critical": [
        "DATABASE_URL - PostgreSQL connection string with SSL for cloud databases",
        "JWT_SECRET - Secure random string for JWT token signing (minimum 32 characters)",
        "BASE_URL - Base URL of the deployed application",
        "GEOAPIFY_API_KEY - API key for Geoapify location services"
      ],
      "optional": [
        "SENDGRID_API_KEY - SendGrid API key for email functionality",
        "EMAIL_FROM - Sender email address for system emails",
        "VERCEL_PROJECT_ID - Required only for automated Vercel deployments"
      ]
    },
    "usage_examples": {
      "database_initialization": "ts-node backend/src/scripts/init-database.ts --config=deployment-config.json --env=production",
      "deployment_verification": "ts-node backend/src/scripts/verify-deployment.ts --config=deployment-config.json --env=production",
      "vercel_env_setup": "ts-node backend/src/scripts/setup-vercel-env.ts --config=deployment-config.json --env=production",
      "health_check": "ts-node backend/src/scripts/health-check.ts --config=deployment-config.json --env=production"
    },
    "security_notes": [
      "NEVER commit actual secrets to version control",
      "Replace all placeholder values (your-xxx-here) with actual values",
      "Use different JWT_SECRET values for each environment",
      "Ensure DATABASE_URL includes sslmode=require for cloud databases",
      "Store actual secrets in Vercel environment variables or secure secret management",
      "For production, generate JWT_SECRET using: openssl rand -base64 32"
    ],
    "neon_database_notes": [
      "Neon provides two connection strings: pooled and direct",
      "Use the POOLED connection string for serverless deployments (Vercel)",
      "Pooled connection format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require",
      "Always include ?sslmode=require for Neon connections",
      "Database URL can be found in Neon dashboard under Connection Details"
    ],
    "vercel_deployment_notes": [
      "vercelProjectId can be found in Vercel project settings",
      "vercelTeamId is only needed for team accounts",
      "Environment variables can be set via Vercel CLI or dashboard",
      "Use setup-vercel-env.ts script to automate variable configuration",
      "Vercel automatically injects some variables (VERCEL_URL, etc.)"
    ]
  }
