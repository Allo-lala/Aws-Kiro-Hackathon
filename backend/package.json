{
  "name": "rutty-backend",
  "version": "1.0.0",
  "description": "Rutty Backend - Eco-friendly route planning API server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server-new.ts",
    "start": "node dist/server-new.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:pbt": "vitest --run --reporter=verbose src/**/*.pbt.test.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ormconfig.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ormconfig.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ormconfig.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ormconfig.ts",
    "db:setup": "ts-node src/scripts/setup-database.ts",
    "db:init": "ts-node src/scripts/init-database.ts",
    "db:seed": "ts-node src/scripts/seed-database.ts",
    "db:verify": "ts-node src/scripts/verify-deployment.ts",
    "deploy:check": "ts-node src/scripts/deployment-checklist.ts",
    "deploy:health": "ts-node src/scripts/health-check.ts",
    "vercel:setup-env": "ts-node src/scripts/setup-vercel-env.ts"
  },
  "keywords": [
    "eco-friendly",
    "route-planning",
    "api",
    "backend"
  ],
  "author": "Rutty Development Team",
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/express-validator": "^2.20.33",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.6",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "fast-check": "^3.15.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "winston": "^3.18.3",
    "xss-clean": "^0.1.4"
  }
}
