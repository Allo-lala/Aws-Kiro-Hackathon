# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rutty_dev
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# External API Keys
# Choose one provider: google_maps or geoapify
ROUTE_API_PROVIDER=google_maps
ROUTE_API_KEY=your-api-key-here
# GOOGLE_MAPS_API_KEY=your-google-maps-key-here
# GEOAPIFY_API_KEY=your-geoapify-key-here

# Route API Configuration
ROUTE_API_TIMEOUT=5000
ROUTE_API_MAX_RETRIES=3
ROUTE_CACHE_ENABLED=true
ROUTE_CACHE_TTL_MINUTES=60

# Email Service
# SENDGRID_API_KEY=your-sendgrid-key
# EMAIL_FROM=noreply@rutty.app
BASE_URL=http://localhost:8080

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
