{
  "name": "rutty-eco-route-planner",
  "version": "1.0.0",
  "description": "Rutty: Your Green Journey Companion - An eco-friendly route planning application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:frontend",
    "build:frontend": "webpack --mode production",
    "dev": "npm run build:frontend && node src/frontend/simple-server.js",
    "dev:backend": "ts-node src/index.ts",
    "dev:frontend": "webpack serve --mode development",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:pbt": "vitest --run --reporter=verbose src/**/*.pbt.test.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "eco-friendly",
    "route-planning",
    "sustainability",
    "carbon-footprint"
  ],
  "author": "Rutty Development Team",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.0.0",
    "fast-check": "^3.15.0",
    "html-webpack-plugin": "^5.5.3",
    "prettier": "^3.0.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "jsdom": "^22.1.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "csv-writer": "^1.6.0",
    "express": "^4.18.2",
    "jspdf": "^3.0.4"
  }
}
